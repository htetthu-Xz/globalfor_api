APP_NAME="Global F.O.R Studio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.globalformm.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_DATABASE=global_for
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

PUBLIC_SITE_URL=https://globalformm.com
CORS_ALLOWED_ORIGINS=https://globalformm.com,https://www.globalformm.com
PUBLIC_STORAGE_URL=https://api.globalformm.com/storage

# Set the exact load balancer or reverse-proxy IPs/subnets, comma-separated.
# Use * only when the application cannot be reached except through that proxy.
TRUSTED_PROXIES=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=admin.globalformm.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=admin@globalformm.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
